# Optional executable wrapper, called with: <script> llama-server <app arguments>.
# A nonempty script setting overrides MODEL_PATH and THREADS.
# PRIMARY_MODEL_SCRIPT=/opt/models/primary-wrapper.sh
# The GGUF path and thread count are required only when no wrapper is configured.
PRIMARY_MODEL_PATH=/absolute/path/to/model.gguf
PRIMARY_THREADS=4
PRIMARY_PORT=8081
LOG_LEVEL=INFO
# Start context compaction after this percentage of the active slot's n_ctx.
# Must be an integer from 1 to 99; default is 65.
CONTEXT_COMPACTION_THRESHOLD=65
