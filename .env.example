# Optional executable wrappers, called with: <script> llama-server <app arguments>.
# A nonempty script setting overrides MODEL_PATH and THREADS for that role.
# PRIMARY_MODEL_SCRIPT=/opt/models/primary-wrapper.sh
# SECONDARY_MODEL_SCRIPT=/opt/models/secondary-wrapper.sh
# GGUF paths and threads are required only when no wrapper is configured.
PRIMARY_MODEL_PATH=/absolute/path/to/model.gguf
PRIMARY_THREADS=4
PRIMARY_PORT=8081
SECONDARY_MODEL_PATH=/absolute/path/to/secondary-model.gguf
SECONDARY_THREADS=2
SECONDARY_PORT=8082
LOG_LEVEL=INFO
